@model ShopManagementSystem.Models.Order?
@{
    ViewData["Title"] = "Track Your Order";
    var recentOrders = ViewBag.RecentOrders as List<ShopManagementSystem.Models.Order> ?? new List<ShopManagementSystem.Models.Order>();
    var searchedOrderId = ViewBag.SearchedOrderId as int?;
    var searchedPhone = ViewBag.SearchedPhone as string;
    var searchedTracking = ViewBag.SearchedTrackingNumber as string;
    bool hasSearched = searchedOrderId.HasValue || !string.IsNullOrEmpty(searchedTracking);

    // Stepper calculation
    int stepIndex = 1;
    if (Model != null)
    {
        if (Model.Status == "Cancelled") stepIndex = -1;
        else if (Model.Status == "Completed") stepIndex = 5;
        else if (Model.Status == "Out for Delivery") stepIndex = 4;
        else if (Model.Status == "Shipped") stepIndex = 3;
        else if (Model.Status == "Processing") stepIndex = 2;
        else stepIndex = 1; // Pending
    }
}

<div class="container py-4 my-2">
    <!-- Header -->
    <div class="text-center mb-4">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-2" style="background:rgba(108,62,232,0.1); color:#6C3EE8;">
            <i class="bi bi-geo-alt-fill me-1"></i>Live Order Tracking
        </span>
        <h2 class="fw-bold text-dark">Track Your Parcel</h2>
        <p class="text-muted small">Enter your Order ID and Phone Number, or Tracking Number to check live delivery status.</p>
    </div>

    <!-- Search Form Box -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <form method="get" asp-action="Track">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small fw-bold text-muted text-uppercase">Order ID</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-hash text-muted"></i></span>
                                <input type="number" name="orderId" value="@(searchedOrderId?.ToString() ?? "")" class="form-control bg-light border-start-0" placeholder="e.g. 1024" />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-bold text-muted text-uppercase">Phone Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone text-muted"></i></span>
                                <input type="text" name="phone" value="@searchedPhone" class="form-control bg-light border-start-0" placeholder="e.g. 01712345678" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 fw-semibold py-2" style="background:linear-gradient(135deg, #6C3EE8, #4E26C0); border:none;">
                                <i class="bi bi-search me-1"></i>Track
                            </button>
                        </div>
                    </div>
                    
                    <div class="text-center mt-3">
                        <small class="text-muted">Or track by Tracking Number:</small>
                        <div class="d-inline-flex align-items-center ms-2">
                            <input type="text" name="trackingNumber" value="@searchedTracking" class="form-control form-control-sm d-inline-block bg-light" style="width:200px;" placeholder="e.g. TRK-202610-00001" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary ms-1">Go</button>
                        </div>
                    </div>
                </form>

                @if (recentOrders.Any())
                {
                    <div class="mt-3 pt-3 border-top">
                        <div class="d-flex align-items-center flex-wrap gap-2">
                            <span class="small text-muted fw-semibold"><i class="bi bi-clock-history me-1"></i>Your Recent Orders:</span>
                            @foreach (var ro in recentOrders)
                            {
                                <a asp-action="Track" asp-route-orderId="@ro.Id" asp-route-phone="@ro.Phone"
                                   class="badge bg-light text-dark border text-decoration-none px-2 py-1 hover-badge">
                                    #@ro.Id (@ro.Status)
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model == null && hasSearched)
    {
        <!-- Not Found State -->
        <div class="text-center py-5">
            <div class="avatar-lg bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3">
                <i class="bi bi-search display-5"></i>
            </div>
            <h4 class="fw-bold text-dark">Order Not Found</h4>
            <p class="text-muted small max-w-md mx-auto">
                We couldn't find an order matching your information. Please make sure you entered the correct Order ID and Phone Number.
            </p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Cart" asp-action="MyOrders" class="btn btn-outline-primary btn-sm mt-2">
                    <i class="bi bi-bag-check me-1"></i>View My Orders
                </a>
            }
        </div>
    }
    else if (Model != null)
    {
        <!-- Order Tracking Details -->
        <div class="row g-4">
            <div class="col-lg-8">

                <!-- Order Header Card -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4 pb-3 border-bottom">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <h4 class="fw-bold mb-0 text-dark">Order #@Model.Id</h4>
                                    <span class="badge badge-status-@Model.Status px-3 py-1 rounded-pill">
                                        @Model.Status
                                    </span>
                                </div>
                                <div class="text-muted small">
                                    <span><i class="bi bi-calendar3 me-1"></i>Placed on @Model.OrderDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                                    @if (!string.IsNullOrEmpty(Model.TrackingNumber))
                                    {
                                        <span class="ms-3"><i class="bi bi-upc-scan text-primary me-1"></i>Tracking #: <strong>@Model.TrackingNumber</strong></span>
                                    }
                                </div>
                            </div>
                            <div class="text-md-end">
                                <div class="text-muted small">Total Payable</div>
                                <div class="fs-4 fw-bold text-danger">৳@Model.TotalAmount.ToString("N0")</div>
                                <span class="badge bg-light text-muted border small">@Model.PaymentMethod</span>
                            </div>
                        </div>

                        <!-- Visual Stepper Progress Bar -->
                        @if (Model.Status == "Cancelled")
                        {
                            <div class="alert alert-danger rounded-3 py-3 d-flex align-items-center gap-3">
                                <i class="bi bi-x-circle-fill fs-2"></i>
                                <div>
                                    <h6 class="fw-bold mb-0">This Order Has Been Cancelled</h6>
                                    <div class="small">@(string.IsNullOrEmpty(Model.CancelReason) ? "Order cancelled by customer or support." : "Reason: " + Model.CancelReason)</div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="stepper-wrapper mb-4 py-3">
                                <div class="stepper-item @(stepIndex >= 1 ? "completed" : "") @(stepIndex == 1 ? "active" : "")">
                                    <div class="step-counter"><i class="bi bi-check2"></i></div>
                                    <div class="step-name">Order Placed</div>
                                    <div class="step-time">@Model.OrderDate.ToString("dd MMM, hh:mm tt")</div>
                                </div>
                                <div class="stepper-item @(stepIndex >= 2 ? "completed" : "") @(stepIndex == 2 ? "active" : "")">
                                    <div class="step-counter"><i class="bi bi-box-seam"></i></div>
                                    <div class="step-name">Processing</div>
                                    <div class="step-time">Confirmed</div>
                                </div>
                                <div class="stepper-item @(stepIndex >= 3 ? "completed" : "") @(stepIndex == 3 ? "active" : "")">
                                    <div class="step-counter"><i class="bi bi-truck"></i></div>
                                    <div class="step-name">Shipped</div>
                                    <div class="step-time">In Transit</div>
                                </div>
                                <div class="stepper-item @(stepIndex >= 4 ? "completed" : "") @(stepIndex == 4 ? "active" : "")">
                                    <div class="step-counter"><i class="bi bi-bicycle"></i></div>
                                    <div class="step-name">Out for Delivery</div>
                                    <div class="step-time">With Rider</div>
                                </div>
                                <div class="stepper-item @(stepIndex >= 5 ? "completed" : "") @(stepIndex == 5 ? "active" : "")">
                                    <div class="step-counter"><i class="bi bi-house-check"></i></div>
                                    <div class="step-name">Delivered</div>
                                    <div class="step-time">@(Model.DeliveredAt?.ToString("dd MMM, hh:mm tt") ?? "Completed")</div>
                                </div>
                            </div>
                        }

                        <!-- Secure Delivery OTP Highlight Card -->
                        @if (!string.IsNullOrEmpty(Model.DeliveryOtp))
                        {
                            @if (!Model.IsOtpVerified && (Model.Status == "Out for Delivery" || Model.Status == "Shipped"))
                            {
                                <div class="card border-0 rounded-4 p-4 text-white mb-3" style="background: linear-gradient(135deg, #FF7A2F 0%, #FF4F81 100%);">
                                    <div class="row align-items-center g-3">
                                        <div class="col-md-7">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="bi bi-shield-lock-fill fs-4"></i>
                                                <h5 class="fw-bold mb-0">Your Delivery Verification OTP</h5>
                                            </div>
                                            <p class="mb-0 small text-white text-opacity-90">
                                                Share this 6-digit OTP with your delivery rider when you receive your package to verify and complete delivery safely.
                                            </p>
                                        </div>
                                        <div class="col-md-5 text-center text-md-end">
                                            <div class="d-inline-block bg-white text-dark rounded-3 px-4 py-2 shadow-sm">
                                                <div class="text-muted small fw-bold">DELIVERY OTP</div>
                                                <div class="fs-2 fw-bold font-monospace text-primary tracking-widest" style="letter-spacing:0.35em;">
                                                    @Model.DeliveryOtp
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (Model.IsOtpVerified)
                            {
                                <div class="alert alert-success border-0 rounded-3 py-3 px-3 d-flex align-items-center gap-3">
                                    <i class="bi bi-patch-check-fill text-success fs-3"></i>
                                    <div>
                                        <h6 class="fw-bold mb-0">Delivery Verified via OTP</h6>
                                        <div class="small">
                                            Package successfully delivered on @(Model.DeliveredAt?.ToString("dd MMMM yyyy, hh:mm tt") ?? Model.UpdatedAt?.ToString("dd MMM yyyy") ?? "recently").
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>

                <!-- Live Tracking Timeline Logs -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-primary me-2"></i>Live Tracking Updates</h6>
                    </div>
                    <div class="card-body p-4 pt-0">
                        @if (!Model.TrackingLogs.Any())
                        {
                            <div class="text-muted small py-3">
                                <i class="bi bi-info-circle me-1"></i>Order is confirmed and awaiting rider dispatch. Check back soon for live updates.
                            </div>
                        }
                        else
                        {
                            <div class="user-timeline">
                                @foreach (var log in Model.TrackingLogs.OrderByDescending(l => l.Timestamp))
                                {
                                    <div class="user-timeline-item">
                                        <div class="user-timeline-dot"></div>
                                        <div class="user-timeline-content">
                                            <div class="d-flex justify-content-between align-items-start mb-1 flex-wrap gap-1">
                                                <div class="fw-bold text-dark">@log.Title</div>
                                                <span class="text-muted small">@log.Timestamp.ToString("dd MMM, hh:mm tt")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(log.Description))
                                            {
                                                <div class="text-muted small mb-1">@log.Description</div>
                                            }
                                            @if (!string.IsNullOrEmpty(log.Location))
                                            {
                                                <div class="text-primary small" style="font-size:0.75rem;">
                                                    <i class="bi bi-geo-alt-fill me-1"></i>@log.Location
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- Items Summary -->
                <div class="card border-0 shadow-sm rounded-4 bg-white">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bag-check text-primary me-2"></i>Items in this Package</h6>
                    </div>
                    <div class="card-body p-4 pt-0">
                        @foreach (var item in Model.OrderDetails)
                        {
                            var img = item.Product?.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
                                   ?? item.Product?.Images?.FirstOrDefault()?.ImageUrl;
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom last-border-0">
                                <img src="@img" onerror="this.src='https://via.placeholder.com/50/f8f9fa/6c757d?text=N/A'"
                                     class="rounded-3 border" style="width:50px;height:50px;object-fit:cover;" />
                                <div class="flex-grow-1">
                                    <div class="fw-semibold small">@item.Product?.Name</div>
                                    <div class="text-muted" style="font-size:0.8rem;">
                                        ৳@item.UnitPrice.ToString("N0") × @item.Quantity
                                    </div>
                                </div>
                                <div class="fw-bold text-dark small">
                                    ৳@((item.UnitPrice * item.Quantity).ToString("N0"))
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>

            <!-- Right Column: Delivery Details & Rider -->
            <div class="col-lg-4">

                <!-- Delivery Partner Card -->
                @if (Model.AssignedEmployee != null)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                        <div class="card-body p-4">
                            <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-bicycle text-primary me-2"></i>Your Delivery Partner</h6>
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold fs-4" style="width:48px;height:48px;background:rgba(108,62,232,0.1);color:#6C3EE8;">
                                    @(Model.AssignedEmployee.FullName.Length > 0 ? Model.AssignedEmployee.FullName.Substring(0, 1).ToUpper() : "R")
                                </div>
                                <div>
                                    <div class="fw-bold">@Model.AssignedEmployee.FullName</div>
                                    <div class="text-muted small">Assigned Delivery Hero</div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.AssignedEmployee.PhoneNumber))
                            {
                                <a href="tel:@Model.AssignedEmployee.PhoneNumber" class="btn btn-outline-success btn-sm w-100 mb-2">
                                    <i class="bi bi-telephone-fill me-1"></i>Call Rider: @Model.AssignedEmployee.PhoneNumber
                                </a>
                            }

                            @if (Model.EstimatedDeliveryDate.HasValue)
                            {
                                <div class="bg-light rounded-3 p-2 small text-center text-muted mt-2">
                                    <i class="bi bi-calendar-event me-1"></i>Expected: <strong>@Model.EstimatedDeliveryDate.Value.ToString("dd MMMM yyyy")</strong>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Shipping Address Card -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-geo-alt text-primary me-2"></i>Delivery Address</h6>
                        <div class="mb-2">
                            <div class="text-muted small">Recipient Name</div>
                            <div class="fw-semibold">@Model.User?.FullName</div>
                        </div>
                        <div class="mb-2">
                            <div class="text-muted small">Phone Number</div>
                            <div class="fw-medium"><i class="bi bi-telephone text-success me-1"></i>@Model.Phone</div>
                        </div>
                        <div class="mb-2">
                            <div class="text-muted small">Address</div>
                            <div class="small fw-medium bg-light p-2 rounded-3">@Model.ShippingAddress</div>
                        </div>
                        <div class="mb-0">
                            <div class="text-muted small">Delivery Zone</div>
                            <div class="small fw-semibold text-primary">@Model.DeliveryZone</div>
                        </div>
                    </div>
                </div>

                <!-- Support Card -->
                <div class="card border-0 shadow-sm rounded-4 bg-white">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-headset display-5 text-primary mb-2 d-block"></i>
                        <h6 class="fw-bold text-dark mb-1">Need Help with your Order?</h6>
                        <p class="text-muted small mb-3">Our support team is always ready to assist you.</p>
                        <a asp-controller="Chat" asp-action="Index" class="btn btn-dark btn-sm w-100 rounded-pill">
                            <i class="bi bi-chat-dots me-1"></i>Chat with Support
                        </a>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

<style>
    /* Stepper UI */
    .stepper-wrapper {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
        position: relative;
    }
    .stepper-item {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        text-align: center;
    }
    .stepper-item::before {
        position: absolute;
        content: "";
        border-bottom: 3px solid #e2e8f0;
        width: 100%;
        top: 20px;
        left: -50%;
        z-index: 1;
    }
    .stepper-item:first-child::before {
        content: none;
    }
    .stepper-item .step-counter {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: center;
        align-items: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f1f5f9;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 6px;
        border: 2px solid #e2e8f0;
        transition: all 0.2s ease;
    }
    .stepper-item.completed .step-counter {
        background: #22C55E;
        color: #fff;
        border-color: #22C55E;
    }
    .stepper-item.completed::before {
        border-color: #22C55E;
    }
    .stepper-item.active .step-counter {
        background: #6C3EE8;
        color: #fff;
        border-color: #6C3EE8;
        box-shadow: 0 0 0 4px rgba(108,62,232,0.2);
    }
    .stepper-item .step-name {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
    }
    .stepper-item.active .step-name, .stepper-item.completed .step-name {
        color: #1e293b;
    }
    .stepper-item .step-time {
        font-size: 0.7rem;
        color: #94a3b8;
    }

    @@media (max-width: 576px) {
        .stepper-item .step-name { font-size: 0.68rem; }
        .stepper-item .step-time { display: none; }
        .stepper-item .step-counter { width: 32px; height: 32px; font-size: 0.8rem; }
        .stepper-item::before { top: 16px; }
    }

    /* Vertical User Timeline */
    .user-timeline {
        position: relative;
        padding-left: 20px;
    }
    .user-timeline::before {
        content: '';
        position: absolute;
        top: 8px;
        bottom: 8px;
        left: 6px;
        width: 2px;
        background: #e2e8f0;
    }
    .user-timeline-item {
        position: relative;
        padding-bottom: 20px;
    }
    .user-timeline-item:last-child {
        padding-bottom: 0;
    }
    .user-timeline-dot {
        position: absolute;
        left: -20px;
        top: 6px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #6C3EE8;
        border: 3px solid #fff;
        box-shadow: 0 0 0 1px #6C3EE8;
    }
    .user-timeline-content {
        background: #f8fafc;
        border-radius: 10px;
        padding: 10px 14px;
        border: 1px solid #f1f5f9;
    }

    .badge-status-Pending          { background:#fef3c7;color:#92400e; }
    .badge-status-Processing       { background:#dbeafe;color:#1e40af; }
    .badge-status-Shipped          { background:#e0e7ff;color:#3730a3; }
    .badge-status-Out\ for\ Delivery { background:#fef08a;color:#854d0e; }
    .badge-status-Completed        { background:#d1fae5;color:#065f46; }
    .badge-status-Cancelled        { background:#fee2e2;color:#991b1b; }
    .hover-badge:hover { background:#e2e8f0 !important; color:#0f172a !important; }
</style>

