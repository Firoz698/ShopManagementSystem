@{
    ViewData["Title"] = "Cancel Order";
    var order = (ShopManagementSystem.Models.Order)ViewBag.Order;
}

<div class="container my-5">
    <div class="card border-0 shadow-sm mx-auto" style="max-width:520px">
        <div class="card-body py-4">
            <h5 class="fw-bold text-danger mb-3">
                <i class="bi bi-exclamation-triangle me-2"></i>Cancel Order #@order.Id?
            </h5>
            <p class="text-muted small mb-4">
                Cancelling this order will return all reserved items to inventory. This action cannot be undone.
            </p>

            <form asp-action="CancelOrder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@order.Id" />

                <div class="mb-3">
                    <label class="form-label">Cancellation Reason (Optional)</label>
                    <textarea name="reason" class="form-control" rows="3"
                              placeholder="Please share why you are cancelling..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Yes, Cancel Order
                    </button>
                    <a asp-action="MyOrders" asp-controller="Cart" class="btn btn-outline-secondary">Go Back</a>
                </div>
            </form>
        </div>
    </div>
</div>
</div>