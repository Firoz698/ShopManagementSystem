@{
    ViewData["Title"] = "অর্ডার বাতিল";
    var order = (ShopManagementSystem.Models.Order)ViewBag.Order;
}

<div class="container my-5">
    <div class="card border-0 shadow-sm mx-auto" style="max-width:520px">
        <div class="card-body py-4">
            <h5 class="fw-bold text-danger mb-3">
                <i class="bi bi-exclamation-triangle me-2"></i>অর্ডার #@order.Id বাতিল করবেন?
            </h5>
            <p class="text-muted small mb-4">
                বাতিল করলে অর্ডারের পণ্যগুলো স্টকে ফেরত যাবে। এই কাজটি আর ফিরিয়ে নেওয়া যাবে না।
            </p>

            <form asp-action="CancelOrder" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@order.Id" />

                <div class="mb-3">
                    <label class="form-label">বাতিলের কারণ (ঐচ্ছিক)</label>
                    <textarea name="reason" class="form-control" rows="3"
                              placeholder="কেন বাতিল করছেন লিখুন..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>হ্যাঁ, বাতিল করুন
                    </button>
                    <a asp-action="MyOrders" asp-controller="Cart" class="btn btn-outline-secondary">ফিরে যান</a>
                </div>
            </form>
        </div>
    </div>
</div>