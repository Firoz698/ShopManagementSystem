@model ShopManagementSystem.Models.PaymentTransaction?
@{ ViewData["Title"] = "Payment Failed"; }

<div class="container my-5 text-center">
    <div class="card border-0 shadow-sm mx-auto" style="max-width:520px">
        <div class="card-body py-5">
            <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-4"
                 style="width:80px;height:80px">
                <i class="bi bi-x-circle-fill text-danger" style="font-size:2.5rem"></i>
            </div>
            <h3 class="fw-bold text-danger mb-2">Payment Failed!</h3>
            <p class="text-muted mb-1">
                @if (Model != null)
                {
                    <span>Transaction ID: <strong>@Model.TransactionId</strong></span>
                }
            </p>
            <p class="text-muted mb-4">
                The payment transaction could not be completed. Please try again.
            </p>

            <div class="d-flex gap-2 justify-content-center">
                @if (Model?.OrderId > 0)
                {
                    <a asp-action="RetryPayment" asp-route-orderId="@Model.OrderId"
                       class="btn btn-primary px-4">
                        <i class="bi bi-arrow-repeat me-2"></i>Retry Payment
                    </a>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    Go to Home
                </a>
            </div>
        </div>
    </div>
</div>

