@model ShopManagementSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<style>
    .auth-wrapper {
        min-height: calc(85vh - var(--navbar-h, 68px));
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
        background: radial-gradient(circle at 10% 20%, rgba(108, 62, 232, 0.05) 0%, rgba(255, 122, 47, 0.03) 90.5%);
    }

    .auth-card {
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 20px 50px -12px rgba(108, 62, 232, 0.15), 0 0 1px 1px rgba(108, 62, 232, 0.08);
        border: 1px solid rgba(108, 62, 232, 0.1);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .auth-banner-side {
        background: linear-gradient(135deg, #6C3EE8 0%, #4E26C0 60%, #361794 100%);
        color: #ffffff;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 3rem 2.5rem;
    }

    .auth-banner-side::before {
        content: "";
        position: absolute;
        top: -60px;
        right: -60px;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 122, 47, 0.4) 0%, rgba(255, 122, 47, 0) 70%);
        filter: blur(20px);
        pointer-events: none;
    }

    .auth-banner-side::after {
        content: "";
        position: absolute;
        bottom: -50px;
        left: -50px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 70%);
        filter: blur(25px);
        pointer-events: none;
    }

    .auth-feature-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        margin-bottom: 12px;
        font-size: 0.9rem;
    }

    .auth-form-side {
        padding: 3rem 2.75rem;
    }

    .form-floating-custom {
        position: relative;
        margin-bottom: 1.25rem;
    }

    .form-floating-custom .input-icon {
        position: absolute;
        top: 50%;
        left: 16px;
        transform: translateY(-50%);
        color: #7B6FA0;
        font-size: 1.15rem;
        z-index: 4;
        transition: color 0.2s ease;
    }

    .form-floating-custom .form-control {
        padding-left: 46px;
        padding-right: 46px;
        height: 52px;
        border-radius: 14px;
        border: 1.5px solid #E2DCF3;
        font-size: 0.95rem;
        background: #FDFCFE;
        color: #1A1235;
        transition: all 0.2s ease-in-out;
    }

    .form-floating-custom .form-control:focus {
        border-color: #6C3EE8;
        background: #ffffff;
        box-shadow: 0 0 0 4px rgba(108, 62, 232, 0.14);
        outline: none;
    }

    .form-floating-custom .form-control:focus ~ .input-icon {
        color: #6C3EE8;
    }

    .toggle-password-btn {
        position: absolute;
        top: 50%;
        right: 14px;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #7B6FA0;
        cursor: pointer;
        padding: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 4;
        border-radius: 8px;
        transition: color 0.2s, background 0.2s;
    }

    .toggle-password-btn:hover {
        color: #6C3EE8;
        background: rgba(108, 62, 232, 0.08);
    }

    .btn-auth-primary {
        background: linear-gradient(135deg, #6C3EE8 0%, #4E26C0 100%);
        border: none;
        color: #ffffff;
        font-weight: 600;
        height: 52px;
        border-radius: 14px;
        letter-spacing: 0.3px;
        font-size: 1rem;
        box-shadow: 0 8px 20px -4px rgba(108, 62, 232, 0.4);
        transition: all 0.25s ease;
    }

    .btn-auth-primary:hover {
        background: linear-gradient(135deg, #5D31D9 0%, #3F1BB0 100%);
        transform: translateY(-2px);
        box-shadow: 0 12px 24px -4px rgba(108, 62, 232, 0.5);
        color: #ffffff;
    }

    .btn-auth-primary:active {
        transform: translateY(0);
    }

    .divider-text {
        position: relative;
        text-align: center;
        margin: 1.5rem 0;
    }

    .divider-text::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: #E8E3F5;
        z-index: 1;
    }

    .divider-text span {
        position: relative;
        z-index: 2;
        background: #ffffff;
        padding: 0 14px;
        color: #8C82A6;
        font-size: 0.825rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .btn-social {
        height: 48px;
        border-radius: 12px;
        font-weight: 500;
        font-size: 0.92rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1.5px solid #E5E0F4;
        background: #ffffff;
        color: #2D2447;
        transition: all 0.2s ease;
    }

    .btn-social:hover {
        background: #F7F5FC;
        border-color: #D3C9F0;
        transform: translateY(-1px);
        color: #1A1235;
    }

    .btn-social-facebook {
        background: #1877F2;
        border-color: #1877F2;
        color: #ffffff;
    }

    .btn-social-facebook:hover {
        background: #1465D1;
        border-color: #1465D1;
        color: #ffffff;
    }

    .form-check-input:checked {
        background-color: #6C3EE8;
        border-color: #6C3EE8;
    }

    .forgot-link {
        color: #6C3EE8;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.875rem;
        transition: color 0.2s;
    }

    .forgot-link:hover {
        color: #FF7A2F;
        text-decoration: underline;
    }

    .auth-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #ffffff;
        padding: 6px 14px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 991.98px) {
        .auth-banner-side {
            padding: 2.25rem 1.75rem;
        }
        .auth-form-side {
            padding: 2.25rem 1.75rem;
        }
    }

    @@media (max-width: 575.98px) {
        .auth-wrapper {
            padding: 1rem 0.5rem;
        }
        .auth-card {
            border-radius: 18px;
        }
        .auth-form-side {
            padding: 1.75rem 1.25rem;
        }
    }
</style>

<div class="auth-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">
                <div class="card auth-card">
                    <div class="row g-0">
                        <!-- Left Decorative Side Panel -->
                        <div class="col-lg-5 d-none d-lg-flex auth-banner-side">
                            <div>
                                <span class="auth-badge">
                                    <i class="bi bi-shield-check"></i> Secure Portal
                                </span>
                                <h2 class="fw-bold text-white mb-2" style="font-size: 1.85rem; line-height: 1.3;">
                                    Welcome Back to Your Store
                                </h2>
                                <p class="text-white-50 small mb-4">
                                    Manage your orders, track shipments, and discover exclusive shopping deals.
                                </p>

                                <div class="auth-feature-item">
                                    <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                                    <span>Fast & Seamless Checkout</span>
                                </div>
                                <div class="auth-feature-item">
                                    <i class="bi bi-shield-lock-fill text-info fs-5"></i>
                                    <span>Bank-Grade Data Encryption</span>
                                </div>
                                <div class="auth-feature-item">
                                    <i class="bi bi-gift-fill text-danger fs-5"></i>
                                    <span>Personalized Member Discounts</span>
                                </div>
                            </div>

                            <div class="pt-4 border-top border-white-50 small text-white-50 d-flex align-items-center justify-content-between">
                                <span>ShopManagement System</span>
                                <span>&copy; @DateTime.Now.Year</span>
                            </div>
                        </div>

                        <!-- Right Form Side -->
                        <div class="col-lg-7 auth-form-side">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div>
                                    <h3 class="fw-bold text-dark mb-1" style="color: #1A1235;">Sign In</h3>
                                    <p class="text-muted small mb-0">Enter your credentials to access your account</p>
                                </div>
                                <div class="p-2 rounded-circle d-flex align-items-center justify-content-center" style="background: #EDE8FF; width: 44px; height: 44px; color: #6C3EE8;">
                                    <i class="bi bi-person-check fs-4"></i>
                                </div>
                            </div>

                            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                            {
                                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 py-2 px-3 mb-4 rounded-3 small" role="alert">
                                    <i class="bi bi-exclamation-octagon-fill fs-5 flex-shrink-0"></i>
                                    <div>
                                        <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                                    </div>
                                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            }

                            <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" autocomplete="on">
                                @Html.AntiForgeryToken()

                                <!-- Email Input -->
                                <div class="form-floating-custom">
                                    <i class="bi bi-envelope input-icon"></i>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Password Input -->
                                <div class="form-floating-custom">
                                    <i class="bi bi-lock input-icon"></i>
                                    <input asp-for="Password" id="passwordInput" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                                    <button type="button" class="toggle-password-btn" id="togglePassword" tabindex="-1" title="Show/Hide Password">
                                        <i class="bi bi-eye" id="toggleIcon"></i>
                                    </button>
                                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Options Row -->
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMeCheck" />
                                        <label asp-for="RememberMe" class="form-check-label small text-muted user-select-none" for="rememberMeCheck">
                                            Remember me
                                        </label>
                                    </div>
                                    <a asp-action="ForgotPassword" class="forgot-link">Forgot password?</a>
                                </div>

                                <!-- Submit Button -->
                                <button type="submit" class="btn btn-auth-primary w-100 d-flex align-items-center justify-content-center gap-2 mb-3">
                                    <span>Sign In to Account</span>
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </form>

                            <!-- Social Login Divider -->
                            <div class="divider-text">
                                <span>or continue with</span>
                            </div>

                            <!-- Social Buttons -->
                            <div class="row g-2 mb-4">
                                <div class="col-sm-6">
                                    <a asp-action="ExternalLogin" asp-route-provider="Google" asp-route-returnUrl="@ViewBag.ReturnUrl"
                                       class="btn btn-social w-100">
                                        <img src="https://www.svgrepo.com/show/475656/google-color.svg" width="18" height="18" alt="Google" />
                                        <span>Google</span>
                                    </a>
                                </div>
                                <div class="col-sm-6">
                                    <a asp-action="ExternalLogin" asp-route-provider="Facebook" asp-route-returnUrl="@ViewBag.ReturnUrl"
                                       class="btn btn-social btn-social-facebook w-100">
                                        <i class="bi bi-facebook fs-5"></i>
                                        <span>Facebook</span>
                                    </a>
                                </div>
                            </div>

                            <!-- Footer Register Link -->
                            <div class="text-center pt-2">
                                <p class="text-muted small mb-0">
                                    Don't have an account yet?
                                    <a asp-action="Register" class="fw-semibold text-decoration-none" style="color: #6C3EE8;">
                                        Create an Account
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggleBtn = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');

            if (toggleBtn && passwordInput && toggleIcon) {
                toggleBtn.addEventListener('click', function() {
                    const isPassword = passwordInput.getAttribute('type') === 'password';
                    passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
                    toggleIcon.classList.toggle('bi-eye', !isPassword);
                    toggleIcon.classList.toggle('bi-eye-slash', isPassword);
                });
            }
        });
    </script>
}
}