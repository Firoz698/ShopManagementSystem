@model RegisterViewModel
@{
    ViewData["Title"] = "Register"; Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <i class="bi bi-person-plus-fill display-4 text-dark"></i>
                        <h4 class="fw-bold mt-2 mb-0">Create New Account</h4>
                        <p class="text-muted small">Register for free</p>
                    </div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-medium small">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-medium small">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="your@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-medium small">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-medium small">Address</label>
                            <textarea asp-for="Address" class="form-control" rows="2"
                                      placeholder="Your delivery address (optional)"></textarea>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-medium small">Password <span class="text-danger">*</span></label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="At least 6 characters" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-medium small">Confirm Password <span class="text-danger">*</span></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Retype password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 fw-semibold">
                            <i class="bi bi-person-check me-2"></i>Create Account
                        </button>
                    </form>

                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1" />
                        <span class="px-2 text-muted small">OR</span>
                        <hr class="flex-grow-1" />
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="ExternalLogin" asp-route-provider="Google"
                           class="btn btn-outline-dark d-flex align-items-center justify-content-center gap-2">
                            <img src="https://www.svgrepo.com/show/475656/google-color.svg" width="18" height="18" alt="Google" />
                            Register with Google
                        </a>
                        <a asp-action="ExternalLogin" asp-route-provider="Facebook"
                           class="btn btn-primary d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-facebook"></i>
                            Register with Facebook
                        </a>
                    </div>

                    <hr class="my-3" />
                    <p class="text-center small mb-0">
                        Already have an account?
                        <a asp-action="Login" class="text-dark fw-semibold">Sign in here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
</div>