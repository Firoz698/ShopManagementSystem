@model EditProfileViewModel
@{
    ViewData["Title"] = "প্রোফাইল এডিট"; Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">প্রোফাইল এডিট করুন</h4>
                    <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                        <div class="text-center mb-3">
                            <img src="@(string.IsNullOrEmpty(Model.CurrentPhotoUrl) ? "/images/default-avatar.png" : Model.CurrentPhotoUrl)"
                                 onerror="this.src='https://ui-avatars.com/api/?name=@Model.FullName&background=6C3EE8&color=fff'"
                                 class="rounded-circle" width="100" height="100" style="object-fit:cover" />
                            <div class="mt-2">
                                <input type="file" asp-for="ProfilePhotoFile" class="form-control form-control-sm" accept="image/*" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label small">পুরো নাম</label>
                            <input asp-for="FullName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label small">ফোন নম্বর</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label small">ঠিকানা</label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label small">লিঙ্গ</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">নির্বাচন করুন</option>
                                    <option value="Male">পুরুষ</option>
                                    <option value="Female">মহিলা</option>
                                    <option value="Other">অন্যান্য</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label small">জন্ম তারিখ</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-dark w-100">আপডেট করুন</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>