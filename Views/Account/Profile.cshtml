@model ShopManagementSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile"; Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <img src="@(string.IsNullOrEmpty(Model.ProfilePhoto) ? "/images/default-avatar.png" : Model.ProfilePhoto)"
                             onerror="this.src='https://ui-avatars.com/api/?name=@Model.FullName&background=6C3EE8&color=fff'"
                             class="rounded-circle" width="110" height="110" style="object-fit:cover" />
                        <h4 class="fw-bold mt-3 mb-0">@Model.FullName</h4>
                        <p class="text-muted small mb-0">@Model.Email</p>
                    </div>

                    <hr class="my-3" />

                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted small">Phone Number</span>
                        <span class="fw-medium">@(Model.PhoneNumber ?? "Not provided")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted small">Address</span>
                        <span class="fw-medium">@(Model.Address ?? "Not provided")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted small">Gender</span>
                        <span class="fw-medium">@(Model.Gender ?? "Not specified")</span>
                    </div>
                    <div class="mb-2 d-flex justify-content-between">
                        <span class="text-muted small">Date of Birth</span>
                        <span class="fw-medium">@(Model.DateOfBirth?.ToString("dd MMM, yyyy") ?? "Not provided")</span>
                    </div>

                    <hr class="my-3" />

                    <div class="d-grid gap-2">
                        <a asp-action="EditProfile" class="btn btn-dark">
                            <i class="bi bi-pencil-square me-1"></i> Edit Profile
                        </a>
                        <a asp-action="ChangePassword" class="btn btn-outline-dark">
                            <i class="bi bi-shield-lock me-1"></i> Change Password
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
</div>