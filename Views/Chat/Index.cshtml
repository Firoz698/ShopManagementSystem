@model List<ShopManagementSystem.Models.ChatMessage>
@{
    ViewData["Title"] = "Support Chat";
}

@{
    var currentUser = ViewBag.CurrentUser as ShopManagementSystem.Models.ApplicationUser;
    var adminPhoto = ViewBag.AdminPhoto as string;
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="height:75vh; display:flex; flex-direction:column;">

                <!-- Header -->
                <div class="card-header bg-dark text-white d-flex align-items-center gap-3 py-3">
                    @if (!string.IsNullOrEmpty(adminPhoto))
                    {
                        <img src="@adminPhoto" class="rounded-circle flex-shrink-0"
                             width="42" height="42" style="object-fit:cover" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-success d-flex align-items-center justify-content-center"
                             style="width:42px;height:42px;flex-shrink:0">
                            <i class="bi bi-headset fs-5"></i>
                        </div>
                    }
                    <div>
                        <div class="fw-bold">ShopMS Support</div>
                        <div class="small opacity-75" id="adminStatus">
                            <span class="badge bg-success rounded-pill px-2 py-1">● Online</span>
                        </div>
                    </div>
                    <div class="ms-auto small opacity-75">
                        <i class="bi bi-lock-fill me-1"></i>Secure Chat
                    </div>
                </div>

                <!-- Messages -->
                <div class="card-body p-3 overflow-auto flex-grow-1" id="messageArea"
                     style="background:#f8f9fa;">

                    <!-- Welcome message -->
                    <div class="text-center mb-3">
                        <span class="badge bg-secondary rounded-pill px-3 py-2 small">
                            Chat started
                        </span>
                    </div>

                    @if (!Model.Any())
                    {
                        <div class="text-center text-muted py-4" id="emptyChat">
                            <i class="bi bi-chat-dots display-4 d-block mb-2 opacity-25"></i>
                            <p class="small">How can we help you today? Send us a message!</p>
                        </div>
                    }

                    <!-- Previous messages -->
                    @foreach (var msg in Model)
                    {
                        @if (msg.IsFromAdmin)
                        {
                            <!-- Admin message — left side -->
                            <div class="d-flex gap-2 mb-3">
                                @if (!string.IsNullOrEmpty(adminPhoto))
                                {
                                    <img src="@adminPhoto" class="rounded-circle flex-shrink-0"
                                         width="32" height="32" style="object-fit:cover" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-dark text-white d-flex align-items-center
                                        justify-content-center flex-shrink-0"
                                         style="width:32px;height:32px;font-size:.75rem">
                                        A
                                    </div>
                                }
                                <div>
                                    <div class="bg-white rounded-3 px-3 py-2 shadow-sm"
                                         style="max-width:400px; border-radius:4px 18px 18px 18px !important">
                                        <div class="small">@msg.Message</div>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size:.7rem">
                                        @msg.SentAt.ToString("dd MMM, hh:mm tt")
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- User message — right side -->
                            <div class="d-flex gap-2 mb-3 justify-content-end">
                                <div>
                                    <div class="bg-dark text-white rounded-3 px-3 py-2"
                                         style="max-width:400px; border-radius:18px 4px 18px 18px !important">
                                        <div class="small">@msg.Message</div>
                                    </div>
                                    <div class="text-muted mt-1 text-end" style="font-size:.7rem">
                                        @msg.SentAt.ToString("dd MMM, hh:mm tt")
                                        <i class="bi bi-check2-all text-primary ms-1"></i>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(currentUser?.ProfilePhoto))
                                {
                                    <img src="@currentUser.ProfilePhoto" class="rounded-circle flex-shrink-0"
                                         width="32" height="32" style="object-fit:cover" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center
                                        justify-content-center flex-shrink-0 fw-bold"
                                         style="width:32px;height:32px;font-size:.75rem">
                                        @(currentUser?.FullName?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                <!-- Typing indicator -->
                <div id="typingIndicator" class="px-3 py-1" style="display:none; background:#f8f9fa">
                    <span class="text-muted small">
                        <span class="typing-dots">
                            <span></span><span></span><span></span>
                        </span>
                        Support is typing...
                    </span>
                </div>

                <!-- Input area -->
                <div class="card-footer bg-white border-top p-3">
                    <div class="d-flex gap-2">
                        <input type="text" id="messageInput" class="form-control"
                               placeholder="Type your message..."
                               maxlength="1000"
                               onkeypress="if(event.key==='Enter') sendMessage()" />
                        <button class="btn btn-dark px-4 flex-shrink-0" onclick="sendMessage()">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                    <div class="text-muted mt-1" style="font-size:.72rem">
                        <i class="bi bi-shield-check me-1 text-success"></i>
                        Your messages are encrypted. We typically reply within 5-10 minutes.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .typing-dots span {
        display: inline-block;
        width: 6px;
        height: 6px;
        background: #6c757d;
        border-radius: 50%;
        margin: 0 1px;
        animation: bounce 1.2s infinite;
    }

        .typing-dots span:nth-child(2) {
            animation-delay: .2s;
        }

        .typing-dots span:nth-child(3) {
            animation-delay: .4s;
        }

    @@keyframes bounce {
        0%, 80%, 100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1);
        }
    }

    #messageArea::-webkit-scrollbar {
        width: 4px;
    }

    #messageArea::-webkit-scrollbar-thumb {
        background: #dee2e6;
        border-radius: 4px;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const userId = '@(currentUser?.Id ?? "")';
        const userPhoto = '@Html.Raw(currentUser?.ProfilePhoto ?? "")';
        const userInitial = '@(currentUser?.FullName?.FirstOrDefault().ToString().ToUpper() ?? "U")';
        const adminPhoto = '@Html.Raw(adminPhoto ?? "")';

        function markMessagesRead() {
            var badge = document.getElementById('chatUnreadBadge');
            if (badge) {
                badge.textContent = '0';
                badge.style.display = 'none';
            }
            if (typeof connection !== 'undefined' && connection.state === signalR.HubConnectionState.Connected) {
                connection.invoke("UserMarkAsRead").catch(function() { });
            } else {
                fetch('/Chat/MarkRead', { method: 'POST' }).catch(function() { });
            }
        }

        // Hide navbar chat badge immediately when on chat page
        document.addEventListener('DOMContentLoaded', markMessagesRead);
        window.addEventListener('focus', markMessagesRead);

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function(data) {
            if (data.isFromAdmin) {
                appendAdminMessage(data);
                playNotificationSound();
                markMessagesRead();
            }
        });

        connection.on("UserUnreadCountUpdated", function(count) {
            markMessagesRead();
        });

        connection.on("MessageSent", function(data) {
        });

        connection.on("AdminTyping", function() {
            document.getElementById('typingIndicator').style.display = 'block';
            clearTimeout(window._typingTimer);
            window._typingTimer = setTimeout(function() {
                document.getElementById('typingIndicator').style.display = 'none';
            }, 3000);
        });

        connection.start()
            .then(function() {
                console.log("Chat connected");
                markMessagesRead();
                scrollToBottom();
            })
            .catch(function(err) {
                console.error("Chat error:", err);
            });

        function sendMessage() {
            var input = document.getElementById('messageInput');
            var msg = input.value.trim();
            if (!msg) return;

            appendUserMessage(msg, new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }));
            input.value = '';

            var emptyChat = document.getElementById('emptyChat');
            if (emptyChat) emptyChat.style.display = 'none';

            markMessagesRead();

            connection.invoke("SendMessageToAdmin", msg).catch(function(err) {
                console.error("Send error:", err);
            });
        }

        function appendUserMessage(text, time) {
            var area = document.getElementById('messageArea');
            var avatarHtml = userPhoto
                ? `<img src="${userPhoto}" class="rounded-circle flex-shrink-0" width="32" height="32" style="object-fit:cover" />`
                : `<div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0 fw-bold"
                        style="width:32px;height:32px;font-size:.75rem">${userInitial}</div>`;
            var div = document.createElement('div');
            div.className = 'd-flex gap-2 mb-3 justify-content-end';
            div.innerHTML = `
                <div>
                    <div class="bg-dark text-white rounded-3 px-3 py-2"
                         style="max-width:400px;border-radius:18px 4px 18px 18px !important">
                        <div class="small">${escapeHtml(text)}</div>
                    </div>
                    <div class="text-muted mt-1 text-end" style="font-size:.7rem">
                        ${time} <i class="bi bi-check2 text-secondary ms-1"></i>
                    </div>
                </div>
                ${avatarHtml}`;
            area.appendChild(div);
            scrollToBottom();
        }

        function appendAdminMessage(data) {
            var area = document.getElementById('messageArea');
            var avatarHtml = adminPhoto
                ? `<img src="${adminPhoto}" class="rounded-circle flex-shrink-0" width="32" height="32" style="object-fit:cover" />`
                : `<div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width:32px;height:32px;font-size:.75rem">A</div>`;
            var div = document.createElement('div');
            div.className = 'd-flex gap-2 mb-3';
            div.innerHTML = `
                ${avatarHtml}
                <div>
                    <div class="bg-white rounded-3 px-3 py-2 shadow-sm"
                         style="max-width:400px;border-radius:4px 18px 18px 18px !important">
                        <div class="small">${escapeHtml(data.message)}</div>
                    </div>
                    <div class="text-muted mt-1" style="font-size:.7rem">${data.sentAt}</div>
                </div>`;
            document.getElementById('typingIndicator').style.display = 'none';
            area.appendChild(div);
            scrollToBottom();
        }

        function scrollToBottom() {
            var area = document.getElementById('messageArea');
            area.scrollTop = area.scrollHeight;
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        function playNotificationSound() {
            try {
                var ctx = new (window.AudioContext || window.webkitAudioContext)();
                var osc = ctx.createOscillator();
                var gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.frequency.value = 800;
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.3);
                osc.start(ctx.currentTime);
                osc.stop(ctx.currentTime + 0.3);
            } catch (e) { }
        }
    </script>
}