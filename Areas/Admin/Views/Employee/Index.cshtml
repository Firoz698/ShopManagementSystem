@model List<ShopManagementSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Employee Management";
    var perm = await PermissionChecker.GetPermissionsAsync(User, "Employee");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Employee Management</h3>
    @if (perm.CanCreate)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Employee</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    @if (perm.CanEdit)
                    {
                        <th class="text-end">Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="@(perm.CanEdit ? 4 : 3)" class="text-center text-muted py-4">No employees found.</td></tr>
                }
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.FullName</td>
                        <td>@e.Email</td>
                        <td>@e.PhoneNumber</td>
                        @if (perm.CanEdit)
                        {
                            <td class="text-end">
                                <a asp-action="Permissions" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-shield-check me-1"></i>Menu Permissions
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>