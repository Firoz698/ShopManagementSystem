@model List<ShopManagementSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "এমপ্লয়ি ম্যানেজমেন্ট";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">এমপ্লয়ি ম্যানেজমেন্ট</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>নতুন এমপ্লয়ি</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>নাম</th><th>ইমেইল</th><th>ফোন</th><th class="text-end">অ্যাকশন</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">কোনো এমপ্লয়ি নেই।</td></tr>
                }
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.FullName</td>
                        <td>@e.Email</td>
                        <td>@e.PhoneNumber</td>
                        <td class="text-end">
                            <a asp-action="Permissions" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-shield-check me-1"></i>মেনু পারমিশন
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>