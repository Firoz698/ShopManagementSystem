@model ShopManagementSystem.ViewModels.CreateEmployeeViewModel
@{
    ViewData["Title"] = "নতুন এমপ্লয়ি";
}

<h3 class="mb-4">নতুন এমপ্লয়ি যোগ করুন</h3>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <div class="card">
        <div class="card-body row g-3">
            <div class="col-md-6">
                <label class="form-label">পূর্ণ নাম</label>
                <input asp-for="FullName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">ইমেইল</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">ফোন</label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">পাসওয়ার্ড</label>
                <input asp-for="Password" type="password" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">রোল</label>
                <select asp-for="RoleName" class="form-select">
                    @foreach (var r in (List<Microsoft.AspNetCore.Identity.IdentityRole>)ViewBag.Roles)
                    {
                        <option value="@r.Name">@r.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">তৈরি করুন</button>
        <a asp-action="Index" class="btn btn-light">বাতিল</a>
    </div>
</form>