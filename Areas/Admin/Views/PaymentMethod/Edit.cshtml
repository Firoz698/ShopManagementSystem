@model ShopManagementSystem.Models.PaymentMethodSetting
@{
    ViewData["Title"] = "Edit Payment Method";
}

<h3 class="mb-4">পেমেন্ট মেথড এডিট করুন</h3>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedAt" />

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">মেথডের নাম</label>
                    <input asp-for="MethodName" class="form-control" />
                    <span asp-validation-for="MethodName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">অ্যাকাউন্ট টাইপ</label>
                    <select asp-for="AccountType" class="form-select">
                        <option value="">-- নির্বাচন করুন --</option>
                        <option value="Personal">Personal</option>
                        <option value="Merchant">Merchant</option>
                        <option value="Bank">Bank</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">অ্যাকাউন্ট / ওয়ালেট নম্বর</label>
                    <input asp-for="AccountNumber" class="form-control" />
                    <span asp-validation-for="AccountNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">অ্যাকাউন্ট হোল্ডারের নাম</label>
                    <input asp-for="AccountHolderName" class="form-control" />
                </div>

                <div class="col-12"><hr /><small class="text-muted">নিচেরগুলো শুধু Bank Transfer হলে পূরণ করুন</small></div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">ব্যাংকের নাম</label>
                    <input asp-for="BankName" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">ব্রাঞ্চ</label>
                    <input asp-for="BranchName" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Routing / SWIFT</label>
                    <input asp-for="RoutingOrSwift" class="form-control" />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">নির্দেশনা (কাস্টমার দেখবে)</label>
                    <textarea asp-for="Instructions" class="form-control" rows="3"></textarea>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Display Order</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
                <div class="col-md-4 mb-3 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" role="switch">
                        <label class="form-check-label" asp-for="IsActive">Active রাখুন</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">আপডেট করুন</button>
        <a asp-action="Index" class="btn btn-light">বাতিল</a>
    </div>
</form>