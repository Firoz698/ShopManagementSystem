@model ShopManagementSystem.Models.PaymentMethodSetting
@{
    ViewData["Title"] = "Add Payment Method";
}

<h3 class="mb-4">Add New Payment Method</h3>

<form asp-action="Create" method="post">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Method Name</label>
                    <input asp-for="MethodName" class="form-control" placeholder="e.g. bKash, Nagad, Rocket, Bank Transfer" />
                    <span asp-validation-for="MethodName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Account Type</label>
                    <select asp-for="AccountType" class="form-select">
                        <option value="">-- Select Type --</option>
                        <option value="Personal">Personal</option>
                        <option value="Merchant">Merchant</option>
                        <option value="Bank">Bank</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Account / Wallet Number</label>
                    <input asp-for="AccountNumber" class="form-control" placeholder="01XXXXXXXXX or Bank Account No" />
                    <span asp-validation-for="AccountNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Account Holder Name</label>
                    <input asp-for="AccountHolderName" class="form-control" />
                </div>

                <div class="col-12"><hr /><small class="text-muted">Fill out the following fields only for Bank Transfer</small></div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Bank Name</label>
                    <input asp-for="BankName" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Branch</label>
                    <input asp-for="BranchName" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Routing / SWIFT</label>
                    <input asp-for="RoutingOrSwift" class="form-control" />
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Payment Instructions (Visible to customer)</label>
                    <textarea asp-for="Instructions" class="form-control" rows="3"
                              placeholder="e.g. Please Send Money to the number above and enter your Transaction ID during checkout."></textarea>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label">Display Order</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
                <div class="col-md-4 mb-3 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" role="switch">
                        <label class="form-check-label" asp-for="IsActive">Keep Active</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save Method</button>
        <a asp-action="Index" class="btn btn-light">Cancel</a>
    </div>
</form>