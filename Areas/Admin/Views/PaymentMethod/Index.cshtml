@model List<ShopManagementSystem.Models.PaymentMethodSetting>
@{
    ViewData["Title"] = "Payment Methods";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">পেমেন্ট মেথড সেটিংস</h3>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>নতুন মেথড যোগ করুন
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>মেথড</th>
                    <th>অ্যাকাউন্ট নম্বর</th>
                    <th>অ্যাকাউন্ট হোল্ডার</th>
                    <th>টাইপ</th>
                    <th>স্ট্যাটাস</th>
                    <th class="text-end">অ্যাকশন</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">কোনো পেমেন্ট মেথড যোগ করা হয়নি।</td></tr>
                }
                @foreach (var m in Model)
                {
                    <tr>
                        <td class="fw-semibold">@m.MethodName</td>
                        <td>@m.AccountNumber</td>
                        <td>@m.AccountHolderName</td>
                        <td>@m.AccountType</td>
                        <td>
                            @if (m.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="ToggleActive" asp-route-id="@m.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-toggle2-@(m.IsActive ? "on" : "off")"></i>
                                </button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('আপনি কি নিশ্চিত ডিলিট করতে চান?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>