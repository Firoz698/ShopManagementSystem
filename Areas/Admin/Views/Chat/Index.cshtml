@model List<ShopManagementSystem.Models.ChatSession>
@inject ShopManagementSystem.Services.IPermissionChecker PermissionChecker
@{
    ViewData["Title"] = "Chat Support";
    var perm = await PermissionChecker.GetPermissionsAsync(User, "Chat");
}

@if (!perm.CanView)
{
    <div class="alert alert-danger">
        <i class="bi bi-shield-lock me-2"></i>You do not have permission to view this page.
    </div>
    return;
}

<div class="row g-4">

    <!-- ── Session List ─────────────────────────────────────────────────── -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-chat-dots me-2 text-primary"></i>Conversations
                </h6>
                <span class="badge bg-danger rounded-pill @((int)ViewBag.TotalUnread > 0 ? "" : "d-none")"
                      id="totalUnreadBadge">@ViewBag.TotalUnread</span>
            </div>
            <div class="list-group list-group-flush overflow-auto" style="max-height:70vh"
                 id="sessionList">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-chat-square display-3 d-block mb-2 opacity-25"></i>
                        <p class="small">No active chats</p>
                    </div>
                }
                @foreach (var session in Model)
                {
                    var initial = string.IsNullOrWhiteSpace(session.User?.FullName)
                        ? "U" : session.User.FullName.Trim()[0].ToString().ToUpper();
                    <a href="javascript:void(0)"
                       onclick="loadConversation('@session.UserId', this)"
                       data-user="@session.UserId"
                       class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 px-3 chat-session-item
                        @(session.UnreadCount > 0 ? "bg-light" : "")"
                       id="session-@session.UserId">
                        <!-- Avatar -->
                        @if (!string.IsNullOrEmpty(session.User?.ProfilePhoto))
                        {
                            <img src="@session.User.ProfilePhoto" class="rounded-circle flex-shrink-0"
                                 width="42" height="42" style="object-fit:cover"
                                 onerror="this.src='https://via.placeholder.com/42'" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-dark text-white d-flex align-items-center
                                justify-content-center flex-shrink-0 fw-bold"
                                 style="width:42px;height:42px">
                                @initial
                            </div>
                        }
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold small">@session.User?.FullName</div>
                            <div class="text-muted" style="font-size:.75rem">@session.User?.Email</div>
                            <div class="text-muted" style="font-size:.7rem">
                                @session.LastMessageAt.ToString("dd MMM, hh:mm tt")
                            </div>
                        </div>
                        @if (session.UnreadCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill flex-shrink-0 session-unread-badge">
                                @session.UnreadCount
                            </span>
                        }
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- ── Right panel — AJAX conversation loaded here ──────────── -->
    <div class="col-lg-8">
        <div id="chatPanel" data-can-reply="@perm.CanCreate.ToString().ToLower()">
            <div class="card border-0 shadow-sm h-100 d-flex align-items-center justify-content-center"
                 style="min-height:400px" id="chatPlaceholder">
                <div class="text-center text-muted">
                    <i class="bi bi-chat-left-dots display-2 d-block mb-3 opacity-25"></i>
                    <h5>Select a Conversation</h5>
                    <p class="small">Choose a user from the left list to view or reply to messages.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-session-item.active-session {
        background-color: #e7f1ff !important;
        border-left: 3px solid #0d6efd;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        let currentUserId = null;
        let totalUnreadCount = @((int)ViewBag.TotalUnread);

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        function setTotalUnread(count) {
            totalUnreadCount = Math.max(0, count);
            var totalBadge = document.getElementById('totalUnreadBadge');
            if (totalBadge) {
                totalBadge.textContent = totalUnreadCount;
                totalBadge.classList.toggle('d-none', totalUnreadCount === 0);
            }
            if (window.updateChatSidebarBadge) {
                window.updateChatSidebarBadge(totalUnreadCount);
            }
        }

        function updateTotalUnread(delta) {
            setTotalUnread(totalUnreadCount + delta);
        }

        function loadConversation(userId, linkEl) {
            document.querySelectorAll('.chat-session-item').forEach(function(item) {
                item.classList.remove('active-session');
            });

            var targetItem = linkEl || document.getElementById('session-' + userId);
            if (targetItem) {
                targetItem.classList.add('active-session');
                var badge = targetItem.querySelector('.session-unread-badge');
                if (badge) {
                    var n = parseInt(badge.textContent || "0", 10) || 0;
                    updateTotalUnread(-n);
                    badge.remove();
                }
                targetItem.classList.remove('bg-light');
            }

            currentUserId = userId;

            fetch('/Admin/Chat/ConversationPartial?userId=' + encodeURIComponent(userId))
                .then(function(res) {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.text();
                })
                .then(function(html) {
                    document.getElementById('chatPanel').innerHTML = html;
                    scrollToBottom();
                    connection.invoke("MarkAsRead", userId).catch(function(err) {
                        console.error('MarkAsRead error:', err);
                    });
                })
                .catch(function(err) {
                    console.error('Conversation load error:', err);
                    document.getElementById('chatPanel').innerHTML =
                        '<div class="alert alert-danger m-0">Failed to load conversation. Please try again.</div>';
                });
        }

        connection.on("UnreadCountUpdated", function(data) {
            if (data && data.userId) {
                var item = document.getElementById('session-' + data.userId);
                if (item) {
                    var badge = item.querySelector('.session-unread-badge');
                    if (data.unreadCount <= 0 || data.userId === currentUserId) {
                        if (badge) badge.remove();
                        item.classList.remove('bg-light');
                    } else {
                        item.classList.add('bg-light');
                        if (badge) {
                            badge.textContent = data.unreadCount;
                        } else {
                            var span = document.createElement('span');
                            span.className = 'badge bg-danger rounded-pill flex-shrink-0 session-unread-badge';
                            span.textContent = data.unreadCount;
                            item.appendChild(span);
                        }
                    }
                }
            }
            if (data && typeof data.totalUnread !== 'undefined') {
                setTotalUnread(data.totalUnread);
            }
        });

        connection.on("ReceiveMessage", function(data) {
            if (!data.isFromAdmin) {
                if (data.senderId === currentUserId) {
                    appendUserMessage(data);
                    connection.invoke("MarkAsRead", currentUserId).catch(function() { });
                } else {
                    playNotificationSound();
                    updateTotalUnread(1);
                    var item = document.getElementById('session-' + data.senderId);
                    if (item) {
                        item.classList.add('bg-light');
                        var badge = item.querySelector('.session-unread-badge');
                        if (badge) {
                            badge.textContent = (parseInt(badge.textContent || "0", 10) || 0) + 1;
                        } else {
                            var span = document.createElement('span');
                            span.className = 'badge bg-danger rounded-pill flex-shrink-0 session-unread-badge';
                            span.textContent = '1';
                            item.appendChild(span);
                        }
                    }
                }
            }
        });

        connection.on("MessageSent", function(data) {
            var targetId = data.targetUserId || (data.payload && data.payload.targetUserId);
            if (targetId === currentUserId) {
                appendAdminMessage(data.payload || data);
            }
        });

        connection.on("UserOnline", function(user) {
            if (user.userId === currentUserId) {
                var el = document.getElementById('onlineStatus');
                if (el) {
                    el.textContent = '● Online';
                    el.className = 'badge bg-success rounded-pill px-2';
                }
            }
        });

        connection.on("UserOffline", function(userId) {
            if (userId === currentUserId) {
                var el = document.getElementById('onlineStatus');
                if (el) {
                    el.textContent = '○ Offline';
                    el.className = 'badge bg-secondary rounded-pill px-2';
                }
            }
        });

        connection.on("UserTyping", function(userId) {
            if (userId === currentUserId) {
                var ind = document.getElementById('typingIndicator');
                if (ind) {
                    ind.style.display = 'block';
                    clearTimeout(window._typingTimeout);
                    window._typingTimeout = setTimeout(function() {
                        ind.style.display = 'none';
                    }, 3000);
                }
            }
        });

        connection.start().catch(console.error);

        function sendMessage() {
            var input = document.getElementById('messageInput');
            if (!input || !currentUserId) return;
            var msg = input.value.trim();
            if (!msg) return;
            input.value = '';

            connection.invoke("SendMessageToUser", currentUserId, msg).catch(function(err) {
                console.error("Send error:", err);
                alert('Failed to send message.');
            });
        }

        function appendUserMessage(data) {
            var area = document.getElementById('messageArea');
            if (!area) return;
            var nameEl = document.querySelector('#chatPanel .card-header .fw-bold');
            var initials = nameEl && nameEl.textContent.trim()
                ? nameEl.textContent.trim().charAt(0).toUpperCase() : 'U';
            var div = document.createElement('div');
            div.className = 'd-flex gap-2 mb-3';
            div.innerHTML = `
                        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center flex-shrink-0 fw-bold"
                             style="width:32px;height:32px;font-size:.75rem">${initials}</div>
                        <div>
                            <div class="bg-white rounded-3 px-3 py-2 shadow-sm"
                                 style="max-width:500px;border-radius:4px 18px 18px 18px !important">
                                <div class="small">${escapeHtml(data.message)}</div>
                            </div>
                            <div class="text-muted mt-1" style="font-size:.7rem">${data.sentAt}</div>
                        </div>`;
            area.appendChild(div);
            scrollToBottom();
        }

        function appendAdminMessage(data) {
            var area = document.getElementById('messageArea');
            if (!area) return;
            var div = document.createElement('div');
            div.className = 'd-flex gap-2 mb-3 justify-content-end';
            div.innerHTML = `
                        <div>
                            <div class="bg-dark text-white rounded-3 px-3 py-2"
                                 style="max-width:500px;border-radius:18px 4px 18px 18px !important">
                                <div class="small">${escapeHtml(data.message)}</div>
                            </div>
                            <div class="text-muted mt-1 text-end" style="font-size:.7rem">
                                ${data.sentAt} <i class="bi bi-check2 text-secondary ms-1"></i>
                            </div>
                        </div>
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center flex-shrink-0 fw-bold"
                             style="width:32px;height:32px;font-size:.75rem">A</div>`;
            area.appendChild(div);
            scrollToBottom();
        }

        function scrollToBottom() {
            var area = document.getElementById('messageArea');
            if (area) area.scrollTop = area.scrollHeight;
        }

        function escapeHtml(text) {
            var d = document.createElement('div');
            d.appendChild(document.createTextNode(text || ''));
            return d.innerHTML;
        }

        function playNotificationSound() {
            try {
                var ctx = new (window.AudioContext || window.webkitAudioContext)();
                var osc = ctx.createOscillator();
                var g = ctx.createGain();
                osc.connect(g); g.connect(ctx.destination);
                osc.frequency.value = 700;
                g.gain.setValueAtTime(0.15, ctx.currentTime);
                g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
                osc.start(); osc.stop(ctx.currentTime + 0.4);
            } catch (e) { }
        }
    </script>
}