@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "রোল ম্যানেজমেন্ট";
}

<h3 class="mb-4">রোল ম্যানেজমেন্ট</h3>

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Create" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="text" name="roleName" class="form-control" placeholder="নতুন রোলের নাম" style="max-width:300px" />
            <button type="submit" class="btn btn-primary">যোগ করুন</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>রোলের নাম</th><th class="text-end">অ্যাকশন</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline" onsubmit="return confirm('ডিলিট করবেন?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>