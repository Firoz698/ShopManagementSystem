@model ShopManagementSystem.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<div class="card border-0 shadow-sm" style="max-width:600px">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-medium">Category Name <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label fw-medium">Current Image</label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div>
                        <img src="@Model.ImageUrl" class="rounded" style="width:80px;height:80px;object-fit:cover"
                             onerror="this.style.display='none'" />
                    </div>
                }
                <label class="form-label fw-medium mt-2 small">New Image (Optional)</label>
                <input type="file" name="image" class="form-control form-control-sm" accept="image/*" />
            </div>
            <div class="form-check form-switch mb-4">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label fw-medium">Active</label>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark px-4">
                    <i class="bi bi-check-circle me-2"></i>Update Category
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
}