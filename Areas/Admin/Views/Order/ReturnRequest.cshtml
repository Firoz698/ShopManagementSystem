@{
    ViewData["Title"] = "Return Request";
}

@{
    var order = ViewBag.Order as ShopManagementSystem.Models.Order;
    var product = ViewBag.Product as ShopManagementSystem.Models.Product;
}

<div class="container my-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="MyOrders">My Orders</a></li>
            <li class="breadcrumb-item active">Return Request</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-arrow-return-left text-danger me-2"></i>Submit Return Request
                    </h5>
                </div>
                <div class="card-body p-4">

                    <!-- Product info -->
                    <div class="bg-light rounded-3 p-3 mb-4">
                        <div class="fw-semibold">@product?.Name</div>
                        <div class="text-muted small mt-1">
                            Order #@order?.Id &nbsp;|&nbsp;
                            <span class="badge badge-status-@order?.Status rounded-pill px-2">@order?.Status</span>
                        </div>
                    </div>

                    <!-- Return reasons info -->
                    <div class="alert alert-info border-0 py-2 mb-4 small">
                        <i class="bi bi-info-circle me-2"></i>
                        Valid return reasons include damaged product, wrong product delivery, or mismatch with description.
                        Our team will get in touch within 3-5 business days.
                    </div>

                    <form asp-controller="Order" asp-action="ReturnRequest" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@order?.Id" />
                        <input type="hidden" name="productId" value="@product?.Id" />

                        <!-- Quick reason select -->
                        <div class="mb-3">
                            <label class="form-label fw-medium">Select Return Reason <span class="text-danger">*</span></label>
                            <div class="d-flex flex-column gap-2">
                                @{
                                    var reasons = new[]
                                    {
                                        "Received damaged product",
                                        "Wrong item delivered",
                                        "Product quality is below expectation",
                                        "Item does not match description",
                                        "Other reason"
                                    };
                                }
                                @foreach (var r in reasons)
                                {
                                    <div class="form-check reason-option p-2 border rounded-3"
                                         onclick="selectReason('@r', this)">
                                        <input class="form-check-input" type="radio"
                                               name="_reason_select" value="@r"
                                               id="reason_@r.GetHashCode()" />
                                        <label class="form-check-label w-100 small fw-medium"
                                               for="reason_@r.GetHashCode()" style="cursor:pointer">
                                            @r
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Full reason textarea -->
                        <div class="mb-4">
                            <label class="form-label fw-medium">Detailed Description <span class="text-danger">*</span></label>
                            <textarea name="reason" id="reasonText" class="form-control" rows="4" required
                                      placeholder="Explain the reason for return in detail..."></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger px-4 fw-semibold">
                                <i class="bi bi-send me-2"></i>Submit Request
                            </button>
                            <a asp-controller="Cart" asp-action="MyOrders"
                               class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .reason-option {
        cursor: pointer;
        transition: border-color .2s, background .2s;
    }

    .reason-option:hover {
        border-color: #dc3545 !important;
        background: #fff5f5;
    }

    .reason-option.selected {
        border-color: #dc3545 !important;
        background: #fff5f5;
    }

    .badge-status-Completed {
        background: #d1fae5;
        color: #065f46;
    }

    .badge-status-Shipped {
        background: #e0e7ff;
        color: #3730a3;
    }
</style>

@section Scripts {
    <script>
        function selectReason(text, el) {
            document.querySelectorAll('.reason-option').forEach(function(opt) {
                opt.classList.remove('selected');
            });
            el.classList.add('selected');
            document.getElementById('reasonText').value = text === 'Other reason' ? '' : text;
            if (text === 'Other reason') document.getElementById('reasonText').focus();
        }
    </script>
}

