@model List<ShopManagementSystem.Models.Order>
@{
    ViewData["Title"] = "Delivery & Order Tracking";
    var perm = await PermissionChecker.GetPermissionsAsync(User, "Delivery");
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentSearch = ViewBag.CurrentSearch as string;
    var filterType = ViewBag.FilterType as string;
    var deliveryStaff = ViewBag.DeliveryStaffList as List<ShopManagementSystem.Models.ApplicationUser> ?? new List<ShopManagementSystem.Models.ApplicationUser>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-truck text-primary me-2"></i>Delivery & Order Tracking</h4>
        <p class="text-muted small mb-0">Manage order assignments, real-time rider tracking, and OTP delivery verifications.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </a>
    </div>
</div>

<!-- Quick Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <a asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 hover-card @(string.IsNullOrEmpty(currentStatus) && string.IsNullOrEmpty(filterType) ? "border-primary-subtle shadow" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Total Orders</div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalOrders</div>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="bi bi-receipt fs-5"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-status="Out for Delivery" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 hover-card @(currentStatus == "Out for Delivery" ? "border-primary-subtle shadow" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Out for Delivery</div>
                        <div class="fs-4 fw-bold text-warning">@ViewBag.OutForDeliveryCount</div>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="bi bi-bicycle fs-5"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-status="Completed" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 hover-card @(currentStatus == "Completed" ? "border-primary-subtle shadow" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">Delivered / Done</div>
                        <div class="fs-4 fw-bold text-success">@ViewBag.CompletedCount</div>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="bi bi-check2-circle fs-5"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-action="Index" asp-route-filterType="my" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 hover-card @(filterType == "my" ? "border-primary-subtle shadow" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">My Assigned</div>
                        <div class="fs-4 fw-bold text-purple" style="color:#6C3EE8;">@ViewBag.MyAssignedCount</div>
                    </div>
                    <div class="rounded-circle bg-purple bg-opacity-10 p-3" style="background: rgba(108,62,232,0.1); color:#6C3EE8;">
                        <i class="bi bi-person-badge fs-5"></i>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Filters & Search Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control bg-light border-start-0" placeholder="Search by Order #, Phone, Address, Rider..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm bg-light" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Pending</option>
                    <option value="Processing" selected="@(currentStatus == "Processing")">Processing</option>
                    <option value="Shipped" selected="@(currentStatus == "Shipped")">Shipped</option>
                    <option value="Out for Delivery" selected="@(currentStatus == "Out for Delivery")">Out for Delivery</option>
                    <option value="Completed" selected="@(currentStatus == "Completed")">Completed</option>
                    <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="filterType" class="form-select form-select-sm bg-light" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(filterType))">All Staff Orders</option>
                    <option value="my" selected="@(filterType == "my")">Assigned to Me Only</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
                @if (!string.IsNullOrEmpty(currentStatus) || !string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(filterType))
                {
                    <a asp-action="Index" class="btn btn-light btn-sm" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Orders Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Order / Date</th>
                    <th>Customer & Address</th>
                    <th>Assigned Rider</th>
                    <th>Delivery Status</th>
                    <th>Delivery OTP</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-2 opacity-50"></i>
                            No orders found matching your criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <a asp-action="Detail" asp-route-id="@order.Id" class="fw-bold text-decoration-none text-primary">
                                    #@order.Id
                                </a>
                                @if (!string.IsNullOrEmpty(order.TrackingNumber))
                                {
                                    <div class="text-muted" style="font-size:0.75rem;"><i class="bi bi-upc-scan me-1"></i>@order.TrackingNumber</div>
                                }
                                <div class="text-muted small">@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                            </td>
                            <td>
                                <div class="fw-semibold small">@order.User?.FullName</div>
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@order.Phone</div>
                                <div class="text-muted text-truncate small" style="max-width:220px;" title="@order.ShippingAddress">
                                    <i class="bi bi-geo-alt me-1"></i>@order.ShippingAddress
                                </div>
                            </td>
                            <td>
                                @if (order.AssignedEmployee != null)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-sm bg-purple bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;font-size:0.8rem;background:rgba(108,62,232,0.1);color:#6C3EE8;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-medium small">@order.AssignedEmployee.FullName</div>
                                            <div class="text-muted" style="font-size:0.75rem;">@order.AssignedEmployee.PhoneNumber</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Unassigned</span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-status-@order.Status px-3 py-1 rounded-pill">
                                    @order.Status
                                </span>
                                @if (order.Status == "Completed" && order.DeliveredAt.HasValue)
                                {
                                    <div class="text-success small mt-1" style="font-size:0.72rem;">
                                        <i class="bi bi-check2 me-1"></i>@order.DeliveredAt.Value.ToString("dd MMM, hh:mm tt")
                                    </div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(order.DeliveryOtp))
                                {
                                    if (order.IsOtpVerified)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-shield-check me-1"></i>Verified (@order.DeliveryOtp)
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace px-2 py-1">
                                                <i class="bi bi-key me-1"></i>@order.DeliveryOtp
                                            </span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="fw-bold text-danger">৳@order.TotalAmount.ToString("N0")</div>
                                <div class="text-muted small" style="font-size:0.75rem;">@order.PaymentMethod</div>
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@order.Id" class="btn btn-outline-primary" title="View / Manage Delivery">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (perm.CanEdit && order.Status == "Out for Delivery" && !order.IsOtpVerified)
                                    {
                                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#verifyOtpModal"
                                                data-order-id="@order.Id" data-customer-name="@order.User?.FullName" data-phone="@order.Phone"
                                                onclick="openVerifyModal(this)" title="Verify OTP & Complete Delivery">
                                            <i class="bi bi-shield-check me-1"></i>Verify OTP
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Quick OTP Verification -->
<div class="modal fade" id="verifyOtpModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="VerifyOtp" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" id="modalOrderId" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-shield-check me-2"></i>Verify Delivery OTP</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="bi bi-info-circle me-1"></i>Ask the customer for the 6-digit OTP displayed on their order tracking page.
                    </div>
                    <div class="mb-3 text-center">
                        <label class="form-label fw-bold small text-muted text-uppercase">Enter 6-Digit Delivery OTP</label>
                        <input type="text" name="otp" required maxlength="6" class="form-control form-control-lg text-center fw-bold fs-3 tracking-widest font-monospace" placeholder="000000" autocomplete="off" autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Delivery Note (Optional)</label>
                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="e.g. Received by customer in good condition" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm px-4">
                        <i class="bi bi-check2-circle me-1"></i>Verify & Mark Delivered
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openVerifyModal(btn) {
        var orderId = btn.getAttribute('data-order-id');
        document.getElementById('modalOrderId').value = orderId;
    }
</script>

<style>
    .badge-status-Pending          { background:#fef3c7;color:#92400e; }
    .badge-status-Processing       { background:#dbeafe;color:#1e40af; }
    .badge-status-Shipped          { background:#e0e7ff;color:#3730a3; }
    .badge-status-Out\ for\ Delivery { background:#fef08a;color:#854d0e; }
    .badge-status-Completed        { background:#d1fae5;color:#065f46; }
    .badge-status-Cancelled        { background:#fee2e2;color:#991b1b; }
    .hover-card { transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .hover-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important; }
</style>

