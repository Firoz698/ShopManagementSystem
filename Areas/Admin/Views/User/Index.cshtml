@model List<ShopManagementSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "User Management";
    var perm = await PermissionChecker.GetPermissionsAsync(User, "User");
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-center">Role</th>
                    <th>Registered At</th>
                    @if (perm.CanView || perm.CanEdit || perm.CanDelete)
                    {
                        <th class="text-center">Action</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var role = ((Dictionary<string, string>)ViewBag.UserRoles).GetValueOrDefault(user.Id, "User");
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(user.ProfilePhoto))
                                {
                                    <img src="@user.ProfilePhoto" class="rounded-circle" width="36" height="36" style="object-fit:cover" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold"
                                         style="width:36px;height:36px;font-size:.85rem">
                                        @(user.FullName?.Length > 0 ? user.FullName[0].ToString() : "U")
                                    </div>
                                }
                                <div>
                                    <div class="fw-medium small">@user.FullName</div>
                                </div>
                            </div>
                        </td>
                        <td class="small">@user.Email</td>
                        <td class="small">@user.PhoneNumber</td>
                        <td class="text-center">
                            <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary") rounded-pill">@role</span>
                        </td>
                        <td class="text-muted small">@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        @if (perm.CanView || perm.CanEdit || perm.CanDelete)
                        {
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    @if (perm.CanView)
                                    {
                                        <a asp-action="Detail" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    }
                                    @if (perm.CanEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleRole" asp-route-id="@user.Id" method="post"
                                              onsubmit="return confirm('Change role for this user?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Toggle Role">
                                                <i class="bi bi-shield-lock"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (perm.CanDelete)
                                    {
                                        <form asp-action="Delete" asp-route-id="@user.Id" method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this user? All user data will be lost.')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="@(perm.CanView || perm.CanEdit || perm.CanDelete ? 6 : 5)" class="text-center text-muted py-5">No users found</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white text-muted small">Total @Model.Count users</div>
</div>