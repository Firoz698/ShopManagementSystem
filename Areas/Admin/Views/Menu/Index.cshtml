@model List<ShopManagementSystem.Models.Menu>
@{
    ViewData["Title"] = "মেনু ম্যানেজমেন্ট";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">মেনু ম্যানেজমেন্ট</h3>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>নতুন মেনু</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>টাইটেল</th>
                    <th>Controller/Action</th>
                    <th>Parent</th>
                    <th>Order</th>
                    <th>স্ট্যাটাস</th>
                    <th class="text-end">অ্যাকশন</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            @if (m.ParentId != null)
                            {
                                <span class="text-muted">— </span>
                            }
                            <i class="@m.Icon me-1"></i>@m.Title
                        </td>
                        <td class="small text-muted">@(m.Controller ?? "(গ্রুপ হেডার)") @(m.Controller != null ? "/" + m.Action : "")</td>
                        <td class="small">@m.Parent?.Title</td>
                        <td>@m.SortOrder</td>
                        <td>
                            @if (m.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">Active</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline" onsubmit="return confirm('ডিলিট করবেন?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>